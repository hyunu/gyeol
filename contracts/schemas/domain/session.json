{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gyeol.local/schemas/domain/session.json",
  "title": "Session",
  "description": "Apple 로그인으로 발급된 서버 세션(ADR-0010). token 은 이 응답에서 한 번만 노출되며 서버에는 SHA-256 해시만 저장된다. 30일 절대 만료.",
  "type": "object",
  "required": ["token", "tokenType", "expiresAt", "user"],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 20,
      "description": "Bearer 토큰 원문. 저장하지 말고 안전한 곳(키체인)에 보관한다."
    },
    "tokenType": { "type": "string", "const": "Bearer" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "user": {
      "type": "object",
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
