{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gyeol.local/schemas/common/page.json",
  "title": "Page",
  "description": "커서/오프셋 공통 페이지 응답 봉투. items 의 항목 스키마는 엔드포인트별로 정의한다.",
  "type": "object",
  "required": ["items", "page", "size", "total", "hasNext"],
  "properties": {
    "items": {
      "type": "array",
      "description": "현재 페이지 항목. 항목 스키마는 각 엔드포인트 계약에서 좁힌다."
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "description": "1부터 시작하는 페이지 번호."
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "description": "페이지 크기. 기본값과 상한은 API 규약을 따른다."
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "전체 항목 수."
    },
    "hasNext": {
      "type": "boolean",
      "description": "다음 페이지 존재 여부."
    }
  },
  "additionalProperties": false
}
