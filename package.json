{
  "name": "gyeol",
  "version": "0.2.0",
  "private": true,
  "description": "GYEOL — 웨어러블 대화 기억 서비스. 계약 우선(contract-first) 기반 모노레포.",
  "type": "module",
  "scripts": {
    "start": "node apps/api/server.mjs",
    "test": "node --test tools/test/*.test.mjs tests/*.test.ts tests/unit/*.test.ts",
    "test:db": "node scripts/test-db.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "node tools/validate-contracts.mjs",
    "contract-test": "node tools/contract-test.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:checks": "node scripts/db-checks.mjs",
    "check": "npm run validate && npm run typecheck && npm test"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
