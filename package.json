{
  "name": "gyeol",
  "version": "0.2.0",
  "private": true,
  "description": "GYEOL — 웨어러블 대화 기억 서비스. 계약 우선(contract-first) 기반 모노레포.",
  "type": "module",
  "scripts": {
    "start": "node apps/api/server.mjs",
    "test": "node --test tools/test/*.test.mjs tests/*.test.ts tests/unit/*.test.ts",
    "test:db": "node scripts/test-db.mjs",
    "test:s3": "node scripts/test-s3.mjs",
    "test:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit && playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "node tools/validate-contracts.mjs",
    "contract-test": "node tools/contract-test.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:checks": "node scripts/db-checks.mjs",
    "purge": "node scripts/purge.mjs",
    "bench": "node scripts/bench.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore:rehearsal": "node scripts/db-restore-rehearsal.mjs",
    "codec:measure": "node tools/measure-codecs.mjs",
    "web:install": "npm --prefix apps/web install",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:api-types": "npm --prefix apps/web run api:types",
    "check": "npm run validate && npm run typecheck && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "jose": "^6.2.17",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
